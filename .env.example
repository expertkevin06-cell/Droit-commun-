# Copiez ce fichier en ".env.local" pour le développement local,
# et ajoutez les mêmes variables dans Vercel > Project Settings > Environment Variables.

# Google AI Studio : https://aistudio.google.com/app/apikey
GEMINI_API_KEY=

# Perplexity API : https://www.perplexity.ai/settings/api
PERPLEXITY_API_KEY=

# PISTE / Légifrance (gratuit) : https://piste.gouv.fr
# 1. Créez un compte
# 2. Créez une "application" et abonnez-la à l'API "Légifrance"
# 3. Récupérez le Client ID et le Client Secret
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
